{
  "name": "naturequery-desktop",
  "productName": "NatureQuery",
  "version": "0.9.0",
  "description": "NatureQuery Desktop: ask your databases questions in plain English, on your own computer.",
  "author": {
    "name": "NatureQuery",
    "email": "hello@naturequery.app",
    "url": "https://naturequery.app"
  },
  "homepage": "https://naturequery.app",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node test/e2e/sign-in-and-ai.mjs",
    "sample-db": "node scripts/make-sample-db.mjs",
    "start": "node scripts/start.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:store": "npm run build && electron-builder --win appx --x64 --publish never",
    "store-assets": "node scripts/make-store-assets.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release:win": "npm run build && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "app.naturequery.desktop",
    "productName": "NatureQuery",
    "artifactName": "NatureQuery-${version}-${os}-${arch}-Setup.${ext}",
    "copyright": "Copyright © 2026 NatureQuery",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/sample",
        "to": "sample"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "protocols": [
      {
        "name": "NatureQuery",
        "schemes": [
          "naturequery"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MuhammadHuzaifaNaseem2",
        "repo": "naturequery"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NatureQuery",
      "uninstallDisplayName": "NatureQuery",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "build/icon.png"
    },
    "appx": {
      "identityName": "NatureQuery.NatureQuery",
      "publisher": "CN=9D19EAD4-7685-458B-ABD7-4216760EF54D",
      "publisherDisplayName": "NatureQuery",
      "applicationId": "NatureQuery",
      "displayName": "NatureQuery",
      "backgroundColor": "transparent",
      "languages": [
        "en-US"
      ],
      "artifactName": "NatureQuery-${version}-store-${arch}.${ext}",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1148.0",
    "@clickhouse/client": "^1.24.0",
    "@google-cloud/bigquery": "^9.2.0",
    "@google-cloud/firestore": "^9.3.1",
    "@libsql/client": "^0.18.0",
    "cassandra-driver": "^4.10.0",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.9",
    "exceljs": "^4.4.0",
    "mongodb": "^7.7.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1",
    "snowflake-sdk": "^3.4.0",
    "ssh2": "^1.17.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.1",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.460.0",
    "postcss": "^8.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "sql-formatter": "^15.7.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
